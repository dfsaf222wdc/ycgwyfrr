#!name=Cookie 管控台
#!desc=按域名列表改写 Cookie。用浏览器打开 http://cookie.ctl 管理规则，受控域名还需要安装管理页面生成的「规则模块」。
#!category=工具

# 脚本放在其它位置（例如 GitHub 或 Gist）时，把下面两行的 script-path 和 argument 改成同一个地址。
# argument 用来告诉管理页面脚本在哪里，生成的规则模块会引用同一个地址。

[Script]
CookieCtl-WebUI = type=http-request,pattern=^https?:\/\/cookie\.ctl(?::\d+)?(?:[\/?]|$),requires-body=true,max-size=2097152,timeout=60,script-path=CookieCtl.js,argument=CookieCtl.js
CookieCtl-Update = type=cron,cronexp="23 * * * *",timeout=120,script-path=CookieCtl.js,argument=CookieCtl.js

[MITM]
hostname = %APPEND% cookie.ctl
